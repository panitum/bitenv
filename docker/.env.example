# Project
COMPOSE_PROJECT_NAME=bitrix
SERVER_NAME=bitrix-dev.local
TZ=Europe/Moscow

# Publishing mode
# Host ports:   docker-compose.yml:docker-compose.ports.yml
# Traefik:      docker-compose.yml:docker-compose.traefik.yml (requires https://github.com/panitum/bitenv-proxy)
COMPOSE_FILE=docker-compose.yml:docker-compose.ports.yml

# Host ports
MYSQL_PORT=3306
# Host ports (only for docker-compose.ports.yml)
HTTP_PORT=80
HTTPS_PORT=443
MAILPIT_PORT=8025

# PHP
PHP_VERSION=8.5.12
HOST_UID=1000
HOST_GID=1000

# Xdebug
INSTALL_XDEBUG=false
# Debug mods: off / debug / profile
XDEBUG_MODE=off

# Database
MYSQL_DATABASE=bitrix
MYSQL_USER=bitrix
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_too
