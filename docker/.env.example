# Project
COMPOSE_PROJECT_NAME=bitrix
SERVER_NAME=bitrix-dev.local
TZ=Europe/Moscow

# Host ports
HTTP_PORT=80
HTTPS_PORT=443
MYSQL_PORT=3306
MAILPIT_PORT=8025

# PHP
PHP_VERSION=8.5.12
HOST_UID=1000
HOST_GID=1000

# Xdebug
INSTALL_XDEBUG=false
# Debug mods: off / debug / profile
XDEBUG_MODE=off

# Database
MYSQL_DATABASE=bitrix
MYSQL_USER=bitrix
MYSQL_PASSWORD=change_me
MYSQL_ROOT_PASSWORD=change_me_too
