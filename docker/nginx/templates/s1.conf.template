resolver 127.0.0.11 valid=10s ipv6=off;

# Неизвестный домен или обращение по IP
server {
    listen 80 default_server;
    listen 443 ssl default_server;
    ssl_reject_handshake on;
    server_name _;
    return 444;
}

server {
    listen 80;
    server_name ${SERVER_NAME};
    return 301 https://$host:${HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/nginx/ssl/${SERVER_NAME}.pem;
    ssl_certificate_key /etc/nginx/ssl/${SERVER_NAME}-key.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;

    root /var/www/html;
    index index.php index.html;
    absolute_redirect off;

    set $php_upstream php:9000;

    # External proxy
    # set_real_ip_from 172.16.0.0/12;
    # real_ip_header X-Forwarded-For;

    include snippets/security-headers.conf;
    include snippets/bitrix-deny.conf;

    location / {
        try_files $uri $uri/ /bitrix/urlrewrite.php$is_args$args;
    }

    location ~ \.php$ {
        try_files $uri =404;
        fastcgi_pass $php_upstream;
        include snippets/fastcgi-bitrix.conf;
    }

    location ~* \.(?:css|js|jpe?g|png|gif|webp|avif|svg|ico|woff2?|ttf|eot|mp4|webm)$ {
        expires 30d;
        access_log off;
        try_files $uri =404;
    }
}
